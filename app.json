{
  "expo": {
    "name": "FitKobra",
    "slug": "fitkobra",
    "version": "1.0.136",
    "orientation": "portrait",
    "icon": "./assets/images/fitkobra-icon-emblem.png",
    "scheme": "fitkobra",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitkobra.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FitKobra needs access to your camera to scan food items for recipe and calorie estimation.",
        "NSMicrophoneUsageDescription": "FitKobra needs access to your microphone so you can log workouts using your voice."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/fitkobra-icon-emblem.png",
        "backgroundColor": "#0d1117"
      },
      "package": "com.fitkobra.app",
      "versionCode": 136,
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.BODY_SENSORS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/truefit-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "FitKobra needs access to your camera to scan food items for recipe and calorie estimation."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d1117"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7b870f7-7f10-43cc-9da1-c4678df29ed8"
      }
    }
  }
}
